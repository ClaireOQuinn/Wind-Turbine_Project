ylabel(colorbar, 'Coefficient of Power (C_P)');
hold on;
%labeling contours
clabel(C_d3, h_d3,'Color','k','Fontsize',8,'FontName','Times New Roman');

% Plotting rotor speed constraints
yline(lambda_limits(1), 'm--', 'LineWidth', 1.5); % minimum rotor speed
