optimal_lambda_d3 = x_opt_d3(2);

% Record optimal pitch angle and tip speed ratio for realistic upper bounds
optimal_pitch_d3_2  = x_opt_d3_2(1);
optimal_lambda_d3_2 = x_opt_d3_2(2);

% Maximium coefficient of power
